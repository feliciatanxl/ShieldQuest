# ShieldQuest server configuration.
# Copy this file to `.env` for local development. `.env` is gitignored — never commit it.
# On Railway, set these in the server service's Variables tab instead.

# Postgres connection string.
#   Local dev:  paste Railway Postgres → Variables → DATABASE_PUBLIC_URL here.
#   On Railway: set DATABASE_URL to the reference ${{Postgres.DATABASE_URL}} (private network).
DATABASE_URL=

# Set to true if your Postgres requires TLS. Railway's public proxy works without it.
DATABASE_SSL=false

# Port to listen on. Railway sets PORT itself; this is only for local dev.
PORT=8787

# Comma-separated list of origins allowed to call the API (the game's URLs).
CORS_ORIGINS=http://localhost:5173

# Shared secret facilitators send as the X-Facilitator-Key header to open and close rooms.
# Use a long random string, and a different one in production.
FACILITATOR_KEY=

# Sessions (and everything recorded in them) are deleted this many days after they open.
DATA_RETENTION_DAYS=90
