generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum District {
  SCHOOL
  RETAIL
  DIGITAL
}

enum ScenarioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Guardian {
  VERIFOX
  ECHO
  BEACON
  SHIELDFIN
  CLUEPAW
  BYTEBUDDY
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(8)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  squads    Squad[]
}

model Squad {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(8)
  sessionId    String        @db.Uuid
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@index([sessionId])
  // Enforce max 5 members and min 4 to start inside a transaction in the future join/start service.
}

model Participant {
  // Random per-session pseudonym only. Never add names, NRICs, phone numbers or emails.
  id               String             @id @default(uuid()) @db.Uuid
  squadId          String             @db.Uuid
  squad            Squad              @relation(fields: [squadId], references: [id], onDelete: Cascade)
  joinedAt         DateTime           @default(now())
  guardianProgress GuardianProgress[]

  @@index([squadId])
}

model Scenario {
  id        String         @id @default(uuid()) @db.Uuid
  title     String
  district  District
  status    ScenarioStatus @default(DRAFT)
  // Versioned branching graph: Explore → Investigate → Discuss → Decide → Experience → Protect.
  content   Json
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  choices   Choice[]
}

model Choice {
  id                 String   @id @default(uuid()) @db.Uuid
  scenarioId         String   @db.Uuid
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  nodeId             String
  label              String
  nextNodeId         String?
  delayedConsequence Json?

  @@index([scenarioId, nodeId])
}

model GuardianProgress {
  id            String      @id @default(uuid()) @db.Uuid
  participantId String      @db.Uuid
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  guardian      Guardian
  skill         String
  earnedAt      DateTime?

  @@unique([participantId, guardian])
}
