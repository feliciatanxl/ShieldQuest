{
  "name": "shieldquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.build.json",
    "preview": "vite preview --host 0.0.0.0",
    "start:server": "node dist-server/server/index.js",
    "test": "tsx --test server/tests/*.test.ts src/features/assessment/*.test.ts src/features/consequences/*.test.ts src/features/guardians/*.test.ts src/features/minigames/*.test.ts src/features/scenarios/*.test.ts src/features/voting/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.41.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.3"
  }
}
